<%# encoding: utf-8 %>
<%
  page_title    = "#{page.title} — #{SITE_TITLE}"
  description   = SITE_DESC
  canonical_url = page.url
-%>
<!DOCTYPE html>
<html lang="en">
<head>
<%= renderer.partial('head', page_title: page_title, description: description, canonical_url: canonical_url, root: root) %>
</head>
<body class="page-<%= page.slug.gsub('/', '-') %>">
<%= renderer.partial('header', root: root, current: page.slug) %>
  <main id="main-content">
    <div class="page-body container">
      <h1><%= h(page.title) %></h1>
      <div class="content">
        <%= page.content_html %>
      </div>
    </div>
  </main>
  <script src="<%= root %>assets/gallery.js" defer></script>
<%= renderer.partial('footer', root: root) %>
</body>
</html>
